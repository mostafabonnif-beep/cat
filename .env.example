# OUSSAMA Cutter — environment template
# انسخ هذا الملف إلى .env ثم املأ القيم:  cp .env.example .env
# لا ترفع .env أبداً — محجوب في .gitignore
# المفاتيح مستخرجة آلياً من الكود (os.environ / os.getenv).

# ======================================================================
# AI / LLM
# ======================================================================
# مفتاح Google Gemini الأساسي
GEMINI_API_KEY=
# مفتاح Gemini بديل (أسبقية على GEMINI_API_KEY)
VIRALCUTTER_GEMINI_KEY=
# عدة مفاتيح مفصولة بفاصلة للتدوير عند نفاد الحصة
VIRALCUTTER_GEMINI_KEYS=
# rotate | sticky
VIRALCUTTER_GEMINI_KEY_MODE=rotate
# مفتاح OpenAI (GPT) — اختياري
OPENAI_API_KEY=
# مفتاح فحص المحتوى (يفضل مفتاح منفصل)
OPENAI_MODERATION_API_KEY=

# ======================================================================
# Transcription
# ======================================================================
# faster-whisper | whisperx
VIRALCUTTER_TRANSCRIPTION_BACKEND=faster-whisper
# float16 (GPU) | int8 (CPU)
VIRALCUTTER_FASTER_WHISPER_COMPUTE_TYPE=float16
# توكن HuggingFace (مطلوب لـ pyannote diarization)
HF_TOKEN=
# بديل لـ HF_TOKEN
PYANNOTE_AUTH_TOKEN=

# ======================================================================
# YouTube Upload
# ======================================================================
# ملف OAuth من Google Cloud Console
YT_CLIENT_SECRETS_FILE=client_secrets.json
# ملف التوكن المخزّن
YT_TOKEN_FILE=yt_token.json
# private | unlisted | public
YT_PRIVACY=private
# معرّف تصنيف يوتيوب
YT_CATEGORY_ID=22
# 1 لرفع صورة مصغّرة
VIRALCUTTER_UPLOAD_THUMBNAIL=0

# ======================================================================
# TikTok / Instagram
# ======================================================================
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_PRIVACY=SELF_ONLY
IG_CLIENT_ID=
IG_CLIENT_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=
# رابط عام للفيديو (Instagram يتطلب URL)
IG_VIDEO_URL=
IG_SHARE_TO_FEED=1
IG_HOST_DISABLE=0

# ======================================================================
# Media / B-roll
# ======================================================================
# مقاطع B-roll من Pexels
PEXELS_API_KEY=
# كشف حقوق الموسيقى
ACOUSTID_API_KEY=

# ======================================================================
# Quality gates
# ======================================================================
# 0 لتعطيل بوابة الجودة
VIRALCUTTER_QUALITY_GATE=1
# أدنى نتيجة لقبول المقطع
VIRALCUTTER_MIN_FINAL_SCORE=
# التزام صارم بحدود الجُمل
VIRALCUTTER_STRICT_BOUNDARIES=1
# حد تشابه المقاطع المكررة
VIRALCUTTER_SEMANTIC_DUP_THRESHOLD=
VIRALCUTTER_REPETITION_PENALTY_MAX=
VIRALCUTTER_VARIANT_VERIFY=0
# ربط الصوت بالوجه المتحدث
VIRALCUTTER_VOICE_FACE_LINK=1

# ======================================================================
# WebUI
# ======================================================================
# 0.0.0.0 للوصول من الشبكة
VIRALCUTTER_HOST=127.0.0.1
GRADIO_SERVER_PORT=7860
# اسم مستخدم لحماية الواجهة
VIRALCUTTER_WEBUI_USER=
# كلمة مرور الواجهة — إلزامية عند التعريض للشبكة
VIRALCUTTER_WEBUI_PASSWORD=
VIRALCUTTER_EXTRA_STATIC_DIRS=
# ar | en | pt | fr
VIRALCUTTER_LANG=ar

# ======================================================================
# Paths & storage
# ======================================================================
# مجلد المخرجات
VIRALCUTTER_VIRALS_DIR=VIRALS
# سجل المحتوى المنشور (منع التكرار)
OUSSAMA_CONTENT_REGISTRY=
# قاعدة سياسات السلامة
OUSSAMA_POLICY_DB=
VIRALCUTTER_DENO_PATH=
# عبارة تشفير api_config.local.json
VIRALCUTTER_CONFIG_PASSPHRASE=

# ======================================================================
# Debug & flags
# ======================================================================
VIRALCUTTER_VERBOSE=0
VIRALCUTTER_DEBUG_FACES=0
VIRALCUTTER_SKIP_PREFLIGHT=0
VIRALCUTTER_ALLOW_PLACEHOLDER=0
VIRALCUTTER_ALLOW_UNSAFE_LOAD=0
VIRALCUTTER_ALLOW_UNSIGNED_UPDATE=0
# لا تعطّله في الإنتاج
VIRALCUTTER_DISABLE_SAFETY_WATCHER=0
VIRALCUTTER_CRASH_REPORT=0
VIRALCUTTER_CRASH_ENDPOINT=
